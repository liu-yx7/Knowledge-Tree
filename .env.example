# ==================== RAGFlow 配置 ====================
# RAGFlow 服务地址
MEMOS_RAGFLOW_BASE_URL=http://localhost:9380

# RAGFlow API 密钥（在 RAGFlow 控制台获取）
MEMOS_RAGFLOW_API_KEY=your-ragflow-api-key

# RAGFlow 助手 ID（在 RAGFlow 中创建 Chat Assistant 后获取）
MEMOS_RAGFLOW_ASSISTANT_ID=your-assistant-id

# ==================== 服务配置 ====================
# 服务端口
MEMOS_PORT=5230

# 时区设置
TZ=Asia/Shanghai
