# ==================== RAGFlow 配置 ====================
# RAGFlow 服务地址
MEMOS_RAGFLOW_BASE_URL=http://localhost:9380

# RAGFlow API 密钥（在 RAGFlow 控制台获取）
MEMOS_RAGFLOW_API_KEY=your-ragflow-api-key

# RAGFlow 助手 ID（在 RAGFlow 中创建 Chat Assistant 后获取）
MEMOS_RAGFLOW_ASSISTANT_ID=your-assistant-id

# ==================== 服务配置 ====================
# 服务端口
MEMOS_PORT=5230

# 时区设置
TZ=Asia/Shanghai

######## 启动命令 ######
MEMOS_DRIVER=postgres \
MEMOS_DSN="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable" \
MEMOS_RAGFLOW_BASE_URL=http://106.14.93.228 \
DASHSCOPE_API_KEY=sk-a255485c155048be8acd9f62049a9ae6 \
RAGFLOW_DEFAULT_LLM_ID=qwen-plus@Tongyi-Qianwen \
go run ./cmd/memos --port 8081

